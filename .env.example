# ─────────────────────────────────────────────────────────────────────────────
# AI Marketing Agency — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# ── Anthropic ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Brave Search (competitor research, trend analysis) ────────────────────
BRAVE_API_KEY=BSA...

# ── Notion (client campaign management, content calendars) ────────────────
# NOTION_API_KEY=secret_...
# NOTION_DATABASE_ID=...

# ── Slack (campaign delivery notifications, client comms) ─────────────────
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL_ID=C...

# ── GitHub (asset versioning, landing page tracking) ──────────────────────
# GITHUB_TOKEN=ghp_...

# ── Google Analytics 4 (live performance data) ────────────────────────────
# GA4_PROPERTY_ID=...
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# ── Agency Configuration ───────────────────────────────────────────────────
# Max concurrent workers for the client queue (default: 20)
MAX_WORKERS=20

# Max concurrent Anthropic API calls system-wide (default: 50)
MAX_CONCURRENT_API_CALLS=50

# Max concurrent API calls per client (default: 10)
MAX_CONCURRENT_PER_CLIENT=10

# Competitor intel cache TTL in days (default: 7)
COMPETITOR_CACHE_TTL_DAYS=7

# Content intel cache TTL in days (default: 30)
CONTENT_CACHE_TTL_DAYS=30

# Output directory (default: outputs)
OUTPUT_DIR=outputs

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
