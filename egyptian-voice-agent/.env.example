# ── Brand / persona ──────────────────────────────────────────────────────────
BRAND_NAME=Acme
AGENT_NAME=سارة
AGENT_VOICE=ar-EG-SalmaNeural   # or ar-EG-ShakirNeural for a male voice

# ── Anthropic (LLM) ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-4-5-20251001

# ── Deepgram (primary STT, streaming Arabic) ─────────────────────────────────
DEEPGRAM_API_KEY=...
STT_PROVIDER=deepgram            # deepgram | azure

# ── Azure Speech (TTS + fallback STT) ────────────────────────────────────────
AZURE_SPEECH_KEY=...
AZURE_SPEECH_REGION=westeurope
TTS_PROVIDER=azure               # azure | elevenlabs

# ── ElevenLabs (optional premium TTS) ────────────────────────────────────────
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=...

# ── Twilio (telephony) ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+20...
# Public HTTPS URL your Twilio webhook will POST to (e.g. Fly.io app URL)
PUBLIC_BASE_URL=https://your-app.fly.dev

# ── CRM sink ─────────────────────────────────────────────────────────────────
CRM_SINK=sheets                  # sheets | hubspot | webhook
# Google Sheets (default)
GOOGLE_SERVICE_ACCOUNT_JSON=/app/secrets/gcp-sa.json
GOOGLE_SHEET_ID=1abc...xyz
GOOGLE_SHEET_TAB=Leads
# HubSpot
# HUBSPOT_ACCESS_TOKEN=
# Generic webhook
# CRM_WEBHOOK_URL=

# Optional callback booking
# CALENDLY_WEBHOOK_URL=

# Human-handoff target for TransferToHuman
HUMAN_HANDOFF_NUMBER=+20...

# ── Outbound dialing ─────────────────────────────────────────────────────────
# Path to a CSV of numbers to never dial (one E.164 number per line, optional
# label after a comma). Lines starting with # are ignored.
DNC_PATH=/app/secrets/dnc.csv
# Shared secret for POST /outbound/call. Leave empty to disable the endpoint.
OUTBOUND_API_KEY=

# ── Telemetry ────────────────────────────────────────────────────────────────
TELEMETRY_PATH=/app/data/calls.jsonl

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
